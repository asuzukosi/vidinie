# ANTHROPIC API Key (required for content analysis, script generation, and image labeling)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# REPLICATE API KEY (required for image and video creation)
REPLICATE_API_KEY=your_replicate_api_key_here

# ElevenLabs API Key (required for high-quality voiceover)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Pexels API Key (for stock images and videos)
PEXELS_API_KEY=your_pexels_api_key_here

# Google OAuth (for social login)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_key_here
# Generate a secure random string (e.g., using: openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000
# Base URL for your application (change in production)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated list of trusted origins

# MongoDB Configuration (for Better Auth)
DATABASE=mongodb://localhost:27017
# MongoDB connection string
DB_NAME=vidinie
# Database name

# Stripe Configuration (for Better Auth Stripe plugin)
NEXT_PUBLIC_STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# Stripe webhook secret for verifying webhook signatures

# JWT Configuration (for Python backend - should match BETTER_AUTH_SECRET)
JWT_SECRET=your_jwt_secret_here
# Should be the same as BETTER_AUTH_SECRET for JWT verification
JWT_ALGORITHM=HS256
JWT_EXPIRATION=30
# JWT expiration in days

