# --- AI providers -------------------------------------------------------

# content analysis, outlines, scripts, image labelling, and the agent that
# writes the remotion code
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# generated images (flux-schnell) and clips (seedance-1-lite)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# voiceover and background music
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# stock images and video
PEXELS_API_KEY=your_pexels_api_key_here


# --- data stores --------------------------------------------------------

MONGODB_URI=mongodb://localhost:27017
DB_NAME=vidinie

# redis, for the celery queue and the progress event channel
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379


# --- auth ---------------------------------------------------------------

# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# signature algorithm the backend expects on better auth JWTs
JWT_ALGORITHM=HS256

NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here


# --- billing ------------------------------------------------------------

NEXT_PUBLIC_STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

NEXT_PUBLIC_STARTER_PLAN_PRICE_ID=your_starter_price_id_here
NEXT_PUBLIC_PROFESSIONAL_PLAN_PRICE_ID=your_professional_price_id_here


# --- email --------------------------------------------------------------

# verification, password reset and welcome emails
NEXT_PUBLIC_RESEND_API_KEY=your_resend_api_key_here


# --- addresses ----------------------------------------------------------

# where the frontend finds the backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# where the backend expects the frontend, used for CORS
FRONTEND_URL=http://localhost:3000


# --- analytics ----------------------------------------------------------

NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
